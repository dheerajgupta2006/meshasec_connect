# Template for the local `.env`, which is gitignored and holds real values.
# Copy this file to `.env` and replace every placeholder. Placeholders only —
# never commit a real credential here.

# PostgreSQL connection string used by Prisma at runtime.
# Must be the POOLED endpoint: the app opens many short-lived connections and the
# direct endpoint runs out of slots. On Neon the pooled host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=20&connection_limit=15&pool_timeout=20"

# Unpooled endpoint, used only by `prisma migrate`. Migrations hold advisory
# locks across statements, which a transaction pooler cannot do.
# Same host as above with "-pooler" removed.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=20"

# Clerk authentication. The publishable key is exposed to the browser; the
# secret key is server-only and must never gain a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# LiveKit credentials for the meeting token route (src/app/api/meetings/token).
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Trusted_Application_Origin for the Server Action origin check.
# Server-only, so no NEXT_PUBLIC_ prefix. When set it is the sole allowlist:
# src/lib/meetings/origin.ts compares the request Origin host against it, and
# next.config.mjs derives experimental.serverActions.allowedOrigins from it.
# Set this to the public origin of every deployed environment. A comma-separated
# list is accepted. Comparison is exact on host and port.
TRUSTED_APP_ORIGIN=http://localhost:3000

# LiveKit server URL used by the browser to connect to a room (wss://...)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Optional server-side override for the LiveKit URL used by moderation calls
# (mute, remove, lock, poll broadcasts). Falls back to NEXT_PUBLIC_LIVEKIT_URL
# when unset, which is correct for almost every deployment. Set it only when the
# server should reach LiveKit on a different address from the browser.
# LIVEKIT_URL=wss://your-project.livekit.cloud

# Signing key for guest sessions. Required for guest access — without it
# /api/meetings/guest returns 503 and nobody can join without an account.
# Must be at least 32 characters. Generate one with:
#   node scripts/generate-guest-secret.js
GUEST_SESSION_SECRET=replace-with-a-32-plus-character-random-string

# Web push, used for incoming-call notifications and new direct messages. All
# three are needed together; with any of them missing, push silently does nothing
# and the bell toggle hides itself. Generate a keypair with:
#   node scripts/generate-vapid.js
# The public key is exposed to the browser by design; the private key is not.
# NEXT_PUBLIC_ values are inlined at build time, so a deployed app needs a
# rebuild after adding this one — not just a restart.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address for the push service, so it can reach you about a misbehaving
# subscription. Must be a mailto: URL or an https:// URL.
VAPID_SUBJECT=mailto:you@your-domain.com

# Public base URL used in connection-request emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email delivery for connection requests (Resend). Optional.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Meshasec Connext <noreply@your-domain.com>

# Umami analytics. Optional — both values must be set or the tracker is not
# rendered at all, which is what keeps local development out of your stats.
# Find them under Settings > Websites > (your site) > Edit > Tracking code.
#
# Public by design: the website id is visible in the page source of every Umami
# site and is not a credential. Use eu.umami.is for the EU cloud region, or your
# own origin when self-hosting.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Optional hostname allowlist for the tracker (comma-separated, no scheme).
# Leave unset to derive it from NEXT_PUBLIC_APP_URL, which keeps Vercel preview
# deployments from polluting production numbers. Set it explicitly only if you
# want previews counted too.
# NEXT_PUBLIC_UMAMI_DOMAINS=meshasec-connect.vercel.app

# Azure Speech, used to read translated captions aloud in languages the
# listener's own device has no voice for. Optional — both values must be set or
# the feature falls back to whatever voices the browser already has.
#
# Why this exists: text-to-speech voices come from the operating system, and
# Windows ships none for Telugu, Kannada, Marathi or Malayalam. Without a server
# route, a listener on Chrome and Windows cannot hear those languages at all.
# Synthesising server-side turns it into ordinary audio playback, which works in
# every browser. Local voices are still preferred when they exist: they are free
# and instant, so English and Hindi never reach this.
#
# The free tier covers 500,000 characters a month, roughly ten hours of speech,
# and identical text is synthesised once and cached. Create a Speech resource in
# the Azure portal, then copy a key and its region (for example "centralindia").
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
