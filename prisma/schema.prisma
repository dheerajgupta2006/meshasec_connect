generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Pooled endpoint: the app opens many short-lived connections, which is what
  /// Neon's pooler exists to absorb. The direct endpoint runs out of slots.
  url       = env("DATABASE_URL")
  /// Unpooled endpoint. Migrations take advisory locks, which a transaction
  /// pooler cannot hold across statements.
  directUrl = env("DIRECT_URL")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id       String  @id @default(cuid())
  clerkId  String? @unique
  /// Public handle used to find and connect with this person. Nullable so the
  /// migration is additive; backfilled the next time the user is resolved.
  username String? @unique
  name     String?
  email    String? @unique
  image    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostedMeetings      Meeting[]           @relation("MeetingHost")
  participations      Participant[]
  sentRequests        ConnectionRequest[] @relation("ConnectionSender")
  receivedRequests    ConnectionRequest[] @relation("ConnectionReceiver")
  sentMessages        DirectMessage[]     @relation("MessageSender")
  receivedMessages    DirectMessage[]     @relation("MessageReceiver")
  sentCallInvites     CallInvite[]        @relation("CallInviteSender")
  receivedCallInvites CallInvite[]        @relation("CallInviteReceiver")
  waitingRoomEntries  WaitingRoomEntry[]  @relation("WaitingGuest")
  currentlyHosting    Meeting[]           @relation("MeetingCurrentHost")
  pushSubscriptions   PushSubscription[]
  ownedGroups         Group[]             @relation("GroupOwner")
  groupMemberships    GroupMember[]
  sentGroupMessages   GroupMessage[]      @relation("GroupMessageSender")
}

/// A browser's push endpoint, so a call can reach someone whose tab is closed.
///
/// One row per browser, not per user: the same person on a laptop and a phone has
/// two, and both should ring.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  /// Provided by the browser. Unique per subscription, and the natural key —
  /// re-subscribing the same browser must update rather than duplicate.
  endpoint String @unique
  /// Public key from the browser's keypair, used to encrypt the payload.
  p256dh   String
  auth     String

  /// Kept for diagnostics only; never used to decide anything.
  userAgent String?

  createdAt  DateTime  @default(now())
  /// Bumped on every successful send, so dead endpoints are identifiable.
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-to-one message. Only ever readable or writable by the two people named
/// on the row, and only while an ACCEPTED connection exists between them.
model DirectMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  /// Client-generated idempotency key. A retry or double-tap carrying the same
  /// value is collapsed by the unique index below rather than duplicated.
  clientId   String?
  /// Set the first time the author edits, which is what drives the "(edited)"
  /// tag. Null means never edited.
  editedAt   DateTime?
  /// Soft delete: the row survives so replies pointing at it keep their context,
  /// but the body is no longer served.
  deletedAt  DateTime?

  /// Quoted message. Self-relation, nullable, and deliberately `SetNull` on
  /// delete so removing the quoted row leaves the reply intact.
  replyToId String?
  replyTo   DirectMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   DirectMessage[] @relation("MessageReply")

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([replyToId])
}

/// Cached OpenGraph metadata for a URL shared in a message.
///
/// Cached rather than fetched per render for three reasons: an outbound HTTP
/// request per message per viewer is unacceptable latency, it would let anyone
/// use this app to hammer a third-party site, and it leaks reader activity to
/// that site on every page view.
model LinkPreview {
  id String @id @default(cuid())

  /// SHA-256 hex of the normalized URL, and the real cache key. The URL itself
  /// is not indexed: it can reach 2048 characters, which overflows Postgres'
  /// btree entry limit once multi-byte characters are involved.
  urlHash String @unique
  url     String

  canonicalUrl String?
  title        String?
  description  String?
  imageUrl     String?
  siteName     String?

  /// Set on a successful scrape. Null means every attempt so far has failed.
  fetchedAt     DateTime?
  /// Set when the most recent attempt failed. Failures are cached too, so a dead
  /// or hostile link is not re-fetched on every render.
  failedAt      DateTime?
  /// Kept for diagnostics; never shown to a user.
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// A guest the host has removed from a meeting.
///
/// Guests have no `User` row, so the `WaitingRoomEntry` DENIED row that bans a
/// signed-in participant has nothing to point at. Without this, removing a guest
/// would only disconnect them and they could walk straight back in with the
/// passcode — which would make host moderation meaningless against exactly the
/// people it matters most for.
model MeetingGuestBan {
  id        String   @id @default(cuid())
  meetingId String
  /// The guest id from their session token, not a user id.
  guestId   String
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, guestId])
  @@index([meetingId])
}

/// A guest waiting for the host to admit them.
///
/// Separate from `WaitingRoomEntry` rather than making that table's `userId`
/// nullable: every existing query on it joins through the user relation, and
/// loosening that would put a null check into the middle of the signed-in
/// admission path for the benefit of a case it never handles.
model GuestWaitingEntry {
  id          String @id @default(cuid())
  meetingId   String
  /// From the guest's signed session token. Not a user id.
  guestId     String
  /// Shown to the host in the admit queue, since there is no profile to read.
  displayName String

  status      KnockStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  /// Which host or co-host answered. Null while pending.
  decidedById String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// One knock per guest per meeting: reloading the lobby must not fill the
  /// host's queue with duplicates of the same person.
  @@unique([meetingId, guestId])
  /// Serves the host's pending-queue poll.
  @@index([meetingId, status])
}

enum KnockStatus {
  PENDING
  ADMITTED
  DENIED
}

/// Someone waiting for the host to let them into a meeting.
///
/// Deliberately not a `Participant` until admitted: enrolling on knock would let
/// anyone with the link write themselves into attendance history and bypass the
/// admission check on a later rejoin.
model WaitingRoomEntry {
  id          String      @id @default(cuid())
  meetingId   String
  userId      String
  status      KnockStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  /// Who answered. Null while pending.
  decidedById String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation("WaitingGuest", fields: [userId], references: [id], onDelete: Cascade)

  /// One row per person per meeting: re-knocking updates the existing request
  /// rather than filling the host's queue with duplicates.
  @@unique([meetingId, userId])
  /// Serves the host's pending-queue poll.
  @@index([meetingId, status])
  @@index([userId, status])
}

model ConnectionRequest {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  /// One request row per ordered pair, so a duplicate send is rejected by the
  /// database rather than by application logic.
  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Meeting {
  id                 String                  @id @default(cuid())
  title              String
  hostId             String
  meetingCode        String                  @unique
  createdAt          DateTime                @default(now())
  startsAt           DateTime?
  endsAt             DateTime?
  /// PRIVATE meetings admit only the host and enrolled participants, so a
  /// leaked code is not enough to join. Direct 1-on-1 calls are private; a
  /// meeting created to be shared by link is not.
  isPrivate          Boolean                 @default(false)
  /// Six-digit room PIN for guests who are not enrolled participants.
  ///
  /// Stored in the clear on purpose: the host UI has to *display* it to share
  /// it, which a hash cannot do. It is therefore a low-value, per-room secret,
  /// not a credential — admission still requires a signed-in Clerk session, and
  /// `authorizeMeetingJoin` rate limits attempts so six digits cannot be walked.
  /// Nullable because meetings created before this column existed have none.
  passcode           String?
  /// When true, nobody new may mint a token. Existing participants are
  /// unaffected, so locking does not eject the people already talking.
  isLocked           Boolean                 @default(false)
  /// When true, a non-participant who clears the passcode is placed in the
  /// waiting room instead of being admitted, and needs the host to let them in.
  waitingRoomEnabled Boolean                 @default(false)
  /// Whoever is running the meeting right now.
  ///
  /// Separate from `hostId`, which records who created it and never changes —
  /// that is what the dashboard reports and what meeting history is attributed
  /// to. This one moves: when the acting host leaves and other people are still
  /// talking, it transfers to the longest-present participant so the room is
  /// never left without moderation. Null means nobody has taken over, so the
  /// creator is still the acting host.
  currentHostId      String?
  /// The group this call belongs to, or null for a 1-on-1 or a link meeting.
  ///
  /// `SetNull` rather than `Cascade`: deleting a group must not erase the
  /// attendance history of calls that happened in it. The meeting simply stops
  /// being attributed to a group.
  groupId            String?
  group              Group?                  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  currentHost        User?                   @relation("MeetingCurrentHost", fields: [currentHostId], references: [id], onDelete: SetNull)
  host               User                    @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants       Participant[]
  callInvites        CallInvite[]
  knocks             WaitingRoomEntry[]
  guestKnocks        GuestWaitingEntry[]
  guestBans          MeetingGuestBan[]
  creationRequest    MeetingCreationRequest?

  @@index([hostId])
  @@index([currentHostId])
  /// Serves the per-group call-reuse lookup, which filters by group and recency.
  @@index([groupId, createdAt])
}

/// A mid-call invitation that turns a 1-on-1 into a group call.
///
/// Separate from `Participant` because the two answer different questions:
/// `Participant` is "who attended", this is "who was asked, and did they respond".
/// Keeping them apart means a declined invite leaves no trace in attendance
/// history, and the ringing query never has to guess why a row exists.
model CallInvite {
  id          String    @id @default(cuid())
  meetingId   String
  senderId    String
  receiverId  String
  createdAt   DateTime  @default(now())
  /// Set when the invitee joins. Stops the banner ringing for an answered call.
  acceptedAt  DateTime?
  /// Set when the invitee declines. Also stops the ring, without implying they
  /// ever joined.
  dismissedAt DateTime?

  meeting  Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender   User    @relation("CallInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("CallInviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  /// One row per person per meeting, so re-inviting someone updates the existing
  /// invite (re-ringing them) instead of stacking duplicates in the banner.
  @@unique([meetingId, receiverId])
  /// Serves the ringing poll, which filters by receiver and recency.
  @@index([receiverId, createdAt])
  @@index([meetingId])
}

model MeetingCreationRequest {
  id                String   @id @default(cuid())
  /// Clerk subject from the Verified_Server_Session. Not an FK: idempotency is
  /// scoped to Clerk_User_ID and User.clerkId is nullable.
  clerkId           String
  creationRequestId String
  meetingId         String   @unique
  createdAt         DateTime @default(now())
  meeting           Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([clerkId, creationRequestId])
  @@index([clerkId])
}

model Participant {
  id        String    @id @default(cuid())
  userId    String
  meetingId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  /// Granted by the host during a call. A co-host gets the moderation controls
  /// but not ownership: they cannot end the meeting or manage other co-hosts.
  ///
  /// Lives on `Participant` rather than its own table so it disappears with the
  /// enrollment — removing someone necessarily revokes their co-host rights.
  isCoHost  Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId])
  @@index([meetingId])
  @@index([meetingId, isCoHost])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

/// A named set of people who can chat and call together.
///
/// Membership is the permission boundary, deliberately decoupled from
/// `ConnectionRequest`: you must be connected to someone to *add* them, but the
/// group keeps working afterwards even if two of its members are not connected to
/// each other. Requiring a full mesh of accepted connections would make a group
/// of five collapse the moment any one pair disconnected.
model Group {
  id          String  @id @default(cuid())
  name        String
  /// Optional one-line purpose, shown under the name in the list.
  description String?
  /// Creator, and the only role that can delete the group. Moves on if they
  /// leave, so a group is never left without an owner.
  ownerId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  messages GroupMessage[]
  meetings Meeting[]

  @@index([ownerId])
}

/// One person's place in a group.
model GroupMember {
  id      String    @id @default(cuid())
  groupId String
  userId  String
  role    GroupRole @default(MEMBER)

  joinedAt   DateTime  @default(now())
  /// Read cursor for this member.
  ///
  /// A cursor rather than a per-message flag, which is the one part of
  /// `DirectMessage` that does not generalise: `readAt` works because a direct
  /// message has exactly one recipient, whereas a group message has as many
  /// readers as the group has members. Unread is therefore "messages newer than
  /// this, written by somebody else", which is one indexed count per group
  /// instead of a row per message per member.
  ///
  /// Null means they have never opened the group, so everything counts as unread.
  lastReadAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One membership per person per group, so adding someone twice updates the
  /// existing row rather than giving them two seats and two unread counts.
  @@unique([groupId, userId])
  /// Serves "which groups am I in", which every group page starts with.
  @@index([userId])
  /// Serves the owner/admin lookups that gate member management.
  @@index([groupId, role])
}

/// A message sent to a group.
///
/// Mirrors `DirectMessage` field for field apart from the recipient: one
/// `groupId` in place of a `receiverId`, and no `readAt` (see
/// `GroupMember.lastReadAt`). Keeping the shapes aligned means the thread UI,
/// the link-preview cache and the tokenizer are all reused unchanged.
model GroupMessage {
  id        String    @id @default(cuid())
  groupId   String
  senderId  String
  body      String
  createdAt DateTime  @default(now())
  /// Client-generated idempotency key. A retry or double-tap carrying the same
  /// value is collapsed by the unique index below rather than duplicated.
  clientId  String?
  /// Set the first time the author edits, which is what drives the "(edited)"
  /// tag. Null means never edited.
  editedAt  DateTime?
  /// Soft delete: the row survives so replies pointing at it keep their context,
  /// but the body is no longer served.
  deletedAt DateTime?

  /// Quoted message. Self-relation, nullable, and deliberately `SetNull` on
  /// delete so removing the quoted row leaves the reply intact.
  replyToId String?
  replyTo   GroupMessage?  @relation("GroupMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   GroupMessage[] @relation("GroupMessageReply")

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  /// Serves the thread window, which reads one group newest-first.
  @@index([groupId, createdAt])
  @@index([replyToId])
}
